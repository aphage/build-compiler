HOST_TRIPLE="x86_64-linux-gnu"
TARGET_TRIPLE="arm-linux-gnueabihf"
TARGET_TRIPLE_EXPLICIT=0
TARGET_ARCH="arm"
TARGET_CPU="generic"
TARGET_FLOAT_ABI="hard"
TARGET_FPU="vfpv3-d16"
TARGET_MARCH="armv7-a"
TARGET_GLIBC_TRIPLE="arm-linux-gnueabihf"
TARGET_MUSL_TRIPLE="arm-linux-musleabihf"
TARGET_LLVM_LIBC_TRIPLE="arm-linux-gnueabihf"

LIBC_VARIANT="glibc"
CXX_RUNTIME="libstdc++"

JOBS="$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN || echo 4)"
CONFIG_FILE=""
DRY_RUN=0
PRINT_CONFIG=0
CHECK_HOST_DEPS=0
RESUME_FROM_STAGE=""

GCC_VERSION="14.2.0"
BINUTILS_VERSION="2.43"
LINUX_HEADERS_VERSION="6.6.58"
GLIBC_VERSION="2.40"
MUSL_VERSION="1.2.5"
LLVM_PROJECT_VERSION="19.1.7"
GLIBC_MIN_KERNEL="4.14"

DOWNLOADS_DIR="${ROOT_DIR}/downloads"
BUILD_DIR="${ROOT_DIR}/build"
INSTALL_DIR="${ROOT_DIR}/install"
SYSROOTS_DIR="${ROOT_DIR}/sysroots"
LOGS_DIR="${ROOT_DIR}/logs"
ARTIFACTS_DIR="${ROOT_DIR}/artifacts"
SOURCE_CACHE_DIR="${BUILD_DIR}/sources"
HOST_DEPS_FILE="${ROOT_DIR}/config/ubuntu-24.04-deps.txt"